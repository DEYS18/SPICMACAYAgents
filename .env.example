# Copy to .env and fill in. Never commit .env.

# ── Core ─────────────────────────────────────────────────────────────────────
SECRET_KEY=            # python -c "import secrets; print(secrets.token_hex(32))"
DEBUG=false
PORT=5000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5          # the conversation (both assistants); Admin > Settings can override
# OPENAI_VISION_MODEL=gpt-5.5  # posters and cheques (defaults to OPENAI_MODEL)
# OPENAI_STT_MODEL=gpt-4o-transcribe   # speech to text; more accurate for Indian languages than the mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ── Portal database (MySQL) ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=spicmacay

# ── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@spicmacay.org
# Until SMTP is set (or with Admin > Settings > Emails > Dry run), emails are saved under instance/outbox.

# ── Sign-in and administrators ───────────────────────────────────────────────
AUTH_MODE=open                 # open | email_otp (coordinators sign in with an emailed code)
ADMIN_PASSWORD=                # opens /admin; leave empty to use ADMIN_EMAILS only
ADMIN_EMAILS=                  # comma separated; these coordinators get the admin console
SESSION_COOKIE_SECURE=false    # set true once the site is served over https
# AUTH_DEV_CODES=1             # development only: show sign-in codes on screen when email is a dry run

# ── Web lookups (optional) ───────────────────────────────────────────────────
GOOGLE_API_KEY=                # enable "Places API (New)" and "Knowledge Graph Search API" for this key
# Without a key, Wikipedia, Wikidata and OpenStreetMap are used.

# ── Hosting ──────────────────────────────────────────────────────────────────
INSTANCE_DIR=                  # default ./instance (templates, settings, history, generated files)
URL_PREFIX=                    # e.g. /spicmacay_ai_agent/New_AI_Portal: optional (the sub-path is detected), but makes links in emails complete
ALLOWED_ORIGINS=               # only for cross-origin access; same-origin needs nothing

# ── Unchanged parts of the app ───────────────────────────────────────────────
WEEKLY_EVENTS_REPORT_EMAIL=smhighereducation@spicmacay.com
WEEKLY_ARTIST_REPORT_EMAIL=smhighereducation@spicmacay.com
WEEKLY_REPORT_DAY=mon
WEEKLY_REPORT_HOUR=8
APR_CC_RECIPIENTS=smhighereducation@spicmacay.com     # classic assistant (new one: Admin > Settings > APR)
SEND_WEEKLY_REPORTS_ON_APR_CREATE=false               # classic assistant testing aid; now off by default
GOOGLE_SERVICE_ACCOUNT_FILE=
CONVENTION_DRIVE_FOLDER_ID=
MOVEMENT_DRIVE_FOLDER_ID=
EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_INDEX_DIR=knowledge_index
